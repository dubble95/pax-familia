<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕊️ PaxFamilia"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="통합 크로스 플랫폼 스크린타임 에이전트"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- 서버 및 기기 설정 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 동기화 서버 설정"
                android:textColor="#818CF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 6자리 페어링 코드로 원클릭 간편 연동 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#0F172A"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ 6자리 페어링 코드로 간편 등록"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="부모 대시보드의 [+ 새 기기 등록]에서 발급받은 6자리 숫자를 입력하세요:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPairingCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#1E293B"
                        android:hint="예: 834912"
                        android:inputType="number"
                        android:maxLength="6"
                        android:padding="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPairWithCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#059669"
                        android:text="기기 등록"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="서버 URL (Fly.io 호스팅 주소):"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#0F172A"
                android:hint="https://pax-familia.workers.dev"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="자녀 ID:"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etChildId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#0F172A"
                android:hint="child_1"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="기기 이름:"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#0F172A"
                android:hint="자녀 스마트폰"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="기기 유형:"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgDeviceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="스마트폰"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbTablet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="태블릿"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <!-- 필수 권한 허용 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 필수 권한 허용 가이드"
                android:textColor="#818CF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 사용 기록 접근 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="앱 사용 기록 접근"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUsagePerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="확인 중..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnReqUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정" />
            </LinearLayout>

            <!-- 다른 앱 위에 표시 (오버레이) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다른 앱 위에 그리기 (잠금용)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlayPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="확인 중..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnReqOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정" />
            </LinearLayout>

            <!-- 배터리 최적화 제외 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="배터리 최적화 예외"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBatteryPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="확인 중..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnReqBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정" />
            </LinearLayout>

            <!-- 기기 관리자 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기기 관리자 (무단 삭제 방지)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminPerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="확인 중..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnReqAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="등록" />
            </LinearLayout>
        </LinearLayout>

        <!-- 서비스 가동 버튼 -->
        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="#4F46E5"
            android:text="🕊️ 동기화 및 자녀 보호 서비스 시작"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
