<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PaxFamilia" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:statusBarColor">@color/slate_900</item>
    </style>

    <style name="Theme.PaxFamilia.LockOverlay" parent="Theme.PaxFamilia">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
